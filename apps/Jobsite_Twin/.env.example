# Rayfin API base URL. For local development this is usually emitted by `npx rayfin up`.
VITE_RAYFIN_API_URL=https://your-rayfin-api.example.com

# Rayfin publishable key (`pk-...`). Do not commit a real key outside your trusted team.
VITE_RAYFIN_PUBLISHABLE_KEY=pk-placeholder

# Fabric portal embed settings for the deployed app item.
VITE_FABRIC_PORTAL_URL=https://app.fabric.microsoft.com
VITE_FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
VITE_FABRIC_ITEM_ID=00000000-0000-0000-0000-000000000000
