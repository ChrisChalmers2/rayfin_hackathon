# Teams incoming webhook URL for the F2 Delayed Task Notifier target channel.
# NEVER commit the real value — this file is gitignored by rayfin/.env* in .gitignore.
# Register the webhook: target Teams channel -> ... -> Connectors -> Incoming Webhook.
TEAMS_WEBHOOK_URL=

# GraphQL endpoint of the deployed Rayfin data API (from `rayfin up` output),
# used by the detection job (scripts/detect-delayed-tasks.mjs) to query and
# update Task rows. Same real-value-never-committed rule applies.
GRAPHQL_ENDPOINT=

# Entra service-principal credentials the detection job uses to mint a
# short-lived GraphQL bearer token via the client-credentials flow (see the
# "AUTH DECISION" comment in scripts/detect-delayed-tasks.mjs) rather than
# storing a long-lived token that would go stale between 5-minute runs.
# Register an App Registration with access to the deployed Fabric
# workspace/item, then fill these in. NEVER commit the real client secret.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# OAuth scope/resource to request the token for. Leave unset to default to
# https://graph.fabric.microsoft.com/.default - override once the exact
# scope the deployed data API expects is confirmed post-deploy.
GRAPHQL_SCOPE=